{
  // מסכי בית הכנסת — Cloudflare Worker
  // השם חייב להיות זהה לשם ה-Worker בלוח הבקרה של Cloudflare (אחרת הבנייה האוטומטית נכשלת)
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tv",
  "main": "src/index.js",
  "compatibility_date": "2026-11-17",

  // קבצי האתר (הדף של המסך, דף הניהול)
  "assets": { "directory": "./public", "binding": "ASSETS" },

  // מסד הנתונים (נוצר אוטומטית בפריסה הראשונה; המזהה קבוע כאן כדי שכל פריסה תשתמש באותו מסד)
  "d1_databases": [{ "binding": "DB", "database_id": "66e837d2-9355-4d7f-8547-9fea401ed511" }],

  // אחסון התמונות והסרטונים (R2)
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "coilel" }],

  // חיבור פתוח לכל מסך (Durable Objects — כלול גם במסלול החינמי)
  "durable_objects": { "bindings": [{ "name": "HUB", "class_name": "ScreenHub" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ScreenHub"] }],

  // מזהה הגרסה — כדי שהמסכים ירעננו את עצמם אחרי עדכון
  "version_metadata": { "binding": "CF_VERSION_METADATA" },

  "observability": { "enabled": true, "traces": { "enabled": true } }

  // הסוד ADMIN_KEY מוגדר בלוח הבקרה (Settings → Variables and Secrets), לא כאן
}
